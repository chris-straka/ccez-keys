<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Dictionaries and translation models on first use; ccez-words; the AI. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Camera text: the camera, or the latest screenshot. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Installs its own updates (from the GitHub releases). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Words on screen: each word its own small window over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <!-- ccez-whisper hears held dictation; Android's recogniser hears the rest. -->
        <package android:name="uk.ccez.whisper" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="studio.ccez.app" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ccez-keys"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- simpleperf from the Mac (scripts/perf.sh): profiling by the shell only. -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="uk.ccez.keys.camera" />

        <service
            android:name=".KeysService"
            android:exported="true"
            android:label="ccez-keys"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>

        <!-- Words on screen: where the front app leaves the screen empty
             (node bounds only, never text). Gives typed text to no one:
             it never reads any. -->
        <service
            android:name=".overlay.ScreenWordsService"
            android:exported="true"
            android:label="Words on screen"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/screen_words_service" />
        </service>

        <receiver android:name=".Updater$Done" android:exported="false" />

        <!-- `keys` on the Mac, over adb (adb shell content call). Only the
             shell user and this app may call it (checked in Control). -->
        <!-- Screenshots handed to the app being typed in (pasted from the clipboard panel). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="uk.ccez.keys.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/files" />
        </provider>

        <provider
            android:name=".Control"
            android:authorities="uk.ccez.keys.control"
            android:exported="true" />
    </application>
</manifest>
